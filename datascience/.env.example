# KinderPrint data science — local configuration
#
#   cp .env.example .env
#   source .env
#
# Raw source data is not committed (3.45 GB, immutable, re-downloadable).
# See docs/DATA_ACCESS.md for download links, expected layout and checksums.
#
# Not needed to run the tests: `pytest tests/ -q` works on a fresh clone
# because the derived tables in data/processed/ are committed.

export KINDERPRINT_RAW_DIR="$HOME/Desktop/KinderPrint/data/raw"
